datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Level {
  A1
  A2
  B1
  B2
  C1
  IELTS
}

enum LessonType {
  VIDEO
  PRACTICE
  SPEAKING
  WRITING
}

enum SubmissionType {
  SPEAKING
  WRITING
  QUIZ
}

enum SubmissionStatus {
  PENDING
  GRADED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(255)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  fullName           String               @map("full_name") @db.VarChar(100)
  avatarUrl          String?              @map("avatar_url") @db.VarChar(500)
  role               Role
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  courses            Course[]
  enrollments        Enrollment[]
  submissions        Submission[]
  feedbacksGiven     SubmissionFeedback[] @relation("InstructorFeedbacks")
  flashcardReviews   FlashcardReview[]

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("refresh_tokens")
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  title        String       @db.VarChar(255)
  slug         String       @unique @db.VarChar(255)
  level        Level
  price        Decimal      @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  modules      Module[]
  enrollments  Enrollment[]

  @@map("courses")
}

model Module {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      String   @db.VarChar(255)
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    Lesson[]

  @@map("modules")
}

model Lesson {
  id          String       @id @default(uuid()) @db.Uuid
  moduleId    String       @map("module_id") @db.Uuid
  title       String       @db.VarChar(255)
  videoUrl    String?      @map("video_url") @db.VarChar(500)
  contentText String?      @map("content_text")
  lessonType  LessonType   @map("lesson_type")
  orderIndex  Int          @map("order_index")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("lessons")
}

model Enrollment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  progressPercent Int      @default(0) @map("progress_percent")
  enrolledAt      DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], name: "unique_user_course")
  @@map("enrollments")
}

model Submission {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  lessonId       String             @map("lesson_id") @db.Uuid
  submissionType SubmissionType     @map("submission_type")
  contentText    String?            @map("content_text")
  audioUrl       String?            @map("audio_url") @db.VarChar(500)
  score          Decimal?           @db.Decimal(4, 1)
  status         SubmissionStatus   @default(PENDING)
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  feedbacks      SubmissionFeedback[]

  @@map("submissions")
}

model SubmissionFeedback {
  id               String     @id @default(uuid()) @db.Uuid
  submissionId     String     @map("submission_id") @db.Uuid
  instructorId     String     @map("instructor_id") @db.Uuid
  rubricScores     Json       @map("rubric_scores")
  feedbackText     String?    @map("feedback_text")
  audioFeedbackUrl String?    @map("audio_feedback_url") @db.VarChar(500)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  instructor       User       @relation("InstructorFeedbacks", fields: [instructorId], references: [id], onDelete: Restrict)

  @@map("submission_feedbacks")
}

model FlashcardReview {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  word            String   @db.VarChar(100)
  phonetic        String?  @db.VarChar(100)
  meaning         String
  intervalDays    Int      @default(1) @map("interval_days")
  repetitionCount Int      @default(0) @map("repetition_count")
  easeFactor      Decimal  @default(2.50) @db.Decimal(4, 2) @map("ease_factor")
  nextReviewAt    DateTime @default(now()) @map("next_review_at") @db.Date
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("flashcard_reviews")
}
